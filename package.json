  "author": "Emin Budak",
  "homepage": "https://github.com/MakersMCP/reframekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakersMCP/reframekit.git"
  },
  "bugs": "https://github.com/MakersMCP/reframekit/issues",
  "bin": {
    "reframekit": "skills/reframekit/scripts/reframekit.js"
  },
  "main": "skills/reframekit/scripts/lib/reframe.js",
  "files": [
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
